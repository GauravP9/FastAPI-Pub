{
    "sqltools.useNodeRuntime": true,
    "python.analysis.exclude": [
        "**/venv",
        "**/.venv",
        "**/__pycache__",
        "**/node_modules",
        "**/clone-repo",
        "**/.mypy_cache",
        "**/.pytest_cache",
        "**/alembic/versions"
    ],
    "files.watcherExclude": {
        "**/.git/**": true,
        "**/venv/**": true,
        "**/.venv/**": true,
        "**/__pycache__/**": true,
        "**/.mypy_cache/**": true,
        "**/.pytest_cache/**": true
    },
    "search.exclude": {
        "**/venv": true,
        "**/.venv": true,
        "**/__pycache__": true
    },
    "python.analysis.autoImportCompletions": false
}